rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 1. allowedEmails: 
    //    - Users can read their own email document during login auth check.
    //    - Admins can read all and write.
    match /allowedEmails/{email} {
      allow read: if isAuthenticated() && (request.auth.token.email == email || isAdmin());
      allow write: if isAdmin();
    }
    
    // 2. users
    //    - Any authenticated user can read profiles.
    //    - Users can create/update only their own profile.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
      
      // Notifications subcollection
      match /notifications/{notificationId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && request.auth.uid == userId;
      }
    }
    
    // 3. posts
    //    - Any authenticated user can read all posts.
    //    - Users can create their own.
    //    - Users can update/delete their own, or admin.
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid || 
        isAdmin() || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy', 'reactions'])
      );
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }
    
    // 4. watchlists
    //    - Any authenticated user can read.
    //    - Users can create/update/delete only their own entries.
    match /watchlists/{watchId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // reviews subcollection
      match /reviews/{reviewId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      }
    }
    
    // 5. events
    //    - Any authenticated user can read.
    //    - Admins can create/update/delete.
    //    - Creators can create/update/delete their own events.
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.createdBy == request.auth.uid);
      allow update: if isAuthenticated() && (
        isAdmin() || 
        resource.data.createdBy == request.auth.uid || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvps'])
      );
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.createdBy == request.auth.uid);
      
      // Event notes subcollection
      match /notes/{noteId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated();
      }
    }
    
    // 6. links (Link Saver)
    //    - Any authenticated user can read and create.
    //    - Any authenticated user can update (for upvotes).
    //    - Creators or admins can delete.
    match /links/{linkId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.savedBy == request.auth.uid);
    }
    
    // 7. youtubeQueue (Watch Together)
    //    - Any authenticated user can read and create.
    //    - Admins or creators can delete (dequeue or remove).
    //    - Admins can update (reorder).
    match /youtubeQueue/{queueId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isAdmin();
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.addedBy == request.auth.uid);
    }
    
    // 8. comments (nested under posts)
    match /posts/{postId}/comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid || 
        isAdmin() || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
      );
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin() || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid);
    }
    
    // 9. redditPosts (for tracking comments on Reddit posts within TRN)
    match /redditPosts/{postId} {
      allow read: if isAuthenticated();
      // Only read is needed for the top level post placeholder
    }
    
    match /redditPosts/{postId}/comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid || 
        isAdmin() || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
      );
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }
    // 10. groupStats
    match /groupStats/{statId} {
      allow read: if isAuthenticated();
      // Any authenticated user can update the streak when they post
      allow write: if isAuthenticated(); 
    }

    // 11. polls
    match /polls/{pollId} {
      allow read: if isAuthenticated();
      // Any authenticated user can create polls
      allow create: if isAuthenticated();
      // Users can vote (update polls). In a real app we'd validate the update structure,
      // but for now we allow authenticated users to update it.
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 12. birthdayMessages
    match /birthdayMessages/{boardId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 13. playlists
    match /playlists/{playlistId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.addedBy == request.auth.uid);
      
      // comments subcollection for playlists
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated() && (
          resource.data.authorId == request.auth.uid || 
          isAdmin() || 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        );
        allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    // 14. channels and messages
    match /channels/{channelId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
      
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']));
        allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    // 15. direct messages
    match /dms/{dmId} {
      allow read: if isAuthenticated() && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/dms/$(dmId)).data.participants;
        allow create: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/dms/$(dmId)).data.participants && request.resource.data.authorId == request.auth.uid;
        allow update: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']));
        allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    // 16. aiChats
    match /aiChats/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      
      match /sessions/{sessionId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    match /ai_usage/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // 17. games
    match /gameScores/{gameId}/scores/{scoreId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }
    
    match /gameActivity/{activityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }
    
    match /typeracerGhosts/{ghostId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }
    
    // 18. system
    match /system/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
