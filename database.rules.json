{
  "rules": {
    "presence": {
      ".read": "auth !== null",
      "$uid": {
        ".write": "auth !== null && auth.uid === $uid"
      }
    },
    "typing": {
      ".read": "auth !== null",
      "$threadType": {
        "$threadId": {
          "$uid": {
            ".write": "auth !== null && auth.uid === $uid"
          }
        }
      }
    }
  }
}
